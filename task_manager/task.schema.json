{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task transport contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "date_basis": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "mode": {
      "enum": [
        "prediction",
        "backtest"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "model_version": {
      "const": "HH520 V2.1-Test"
    },
    "status": {
      "enum": [
        "CREATED",
        "STARTUP_CHECK",
        "COLLECTING",
        "DATA_READY",
        "AUDITING",
        "ANALYZING",
        "CALIBRATING",
        "COMMITTING",
        "COMPLETED",
        "ARCHIVED",
        "FAILED",
        "BLOCKED",
        "CANCELLED",
        "PARTIAL_FAILED"
      ]
    },
    "asset_git_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "task_id",
    "request_id",
    "timezone",
    "date_basis",
    "scope",
    "contract_version",
    "mode",
    "date",
    "model_version",
    "status",
    "asset_git_sha",
    "snapshot_id",
    "created_at"
  ]
}
