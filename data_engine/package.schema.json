{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot payload; hash belongs in separate receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "collector": {
      "const": "Firecrawl"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "live",
        "historical_reconstruction"
      ]
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Match facts",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "match_id": {
            "type": "string",
            "minLength": 1
          },
          "fixture_list_date": {
            "type": "string",
            "format": "date"
          },
          "kickoff_at": {
            "type": "string",
            "format": "date-time"
          },
          "home_team": {
            "type": "string",
            "minLength": 1
          },
          "away_team": {
            "type": "string",
            "minLength": 1
          },
          "league": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "sections": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "Source section",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "section_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1
                },
                "source_match_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "collected_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "payload_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "identity_status": {
                  "enum": [
                    "MATCHED",
                    "MISMATCHED",
                    "UNKNOWN"
                  ]
                }
              },
              "required": [
                "section_id",
                "source_url",
                "source_match_id",
                "observed_at",
                "collected_at",
                "content_sha256",
                "payload_ref",
                "identity_status"
              ]
            }
          }
        },
        "required": [
          "match_id",
          "fixture_list_date",
          "kickoff_at",
          "home_team",
          "away_team",
          "league",
          "as_of",
          "sections"
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "snapshot_id",
    "task_id",
    "collector",
    "collected_at",
    "mode",
    "matches"
  ]
}
