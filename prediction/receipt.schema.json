{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commit receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prediction_id": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "git_path": {
      "type": "string",
      "minLength": 1
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "prediction_id",
    "content_sha256",
    "git_commit_sha",
    "git_path",
    "committed_at"
  ]
}
